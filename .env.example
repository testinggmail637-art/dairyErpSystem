APP_NAME="Dairy ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/dairyErpSystem/public
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: mysql (MySQL 8). Local XAMPP ships MariaDB: use mariadb.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dairy_erp
DB_USERNAME=root
DB_PASSWORD=
# Folder containing mysqldump (empty = on the PATH). XAMPP: C:/xampp/mysql/bin
DB_DUMP_BINARY_PATH=

# Backups (docs/BACKUP_RESTORE.md): daily 02:00, kept 14 days
BACKUP_NAME=dairy-erp
BACKUP_DISKS=backups
BACKUP_PATH=
BACKUP_ARCHIVE_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Owner account created by `php artisan db:seed` (change for production)
OWNER_NAME="Owner"
OWNER_EMAIL=owner@dairy.test
OWNER_PHONE=9999999999
OWNER_PASSWORD=password

# Monitoring (spec 4.10, docs/DEPLOYMENT.md)
PULSE_ENABLED=true
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_QUERIES_THRESHOLD=500
PULSE_SLOW_JOBS_THRESHOLD=1000
# Error alerts: paste the DSN from sentry.io in production; empty = Sentry does nothing
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Telescope runs only when APP_ENV=local
TELESCOPE_ENABLED=true
